# Copy to .env and fill in. Never commit .env or private keys.

PORT=3100
# Public HTTPS address of this server. telebirr sends payment notifications to
# PUBLIC_BASE_URL/api/payment/notify, and that URL must be whitelisted by telebirr.
PUBLIC_BASE_URL=https://api.wifi.et.example
# Serve the mini app from this server at / (handy for local testing).
SERVE_MINIAPP=true
# Comma-separated origins allowed to call the API ("*" = any; the API uses bearer tokens, not cookies).
CORS_ORIGINS=*
DATA_DIR=./data

# Long random string used to sign app session tokens.
SESSION_SECRET=change-me-to-a-long-random-string
# Token for the admin endpoints (KYC review, refunds). Long and random.
ADMIN_TOKEN=change-me-too

# ---- telebirr SuperApp payment gateway ----
# mock = no calls to telebirr (local testing). sandbox / production = real gateway.
TELEBIRR_MODE=mock
TELEBIRR_BASE_URL_SANDBOX=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_BASE_URL_PRODUCTION=https://superapp.ethiomobilemoney.et:38443/apiaccess/payment/gateway
# Fabric App ID (X-APP-Key) and App Secret from the developer portal / ET administrator.
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
# Merchant app id (appid) and merchant short code (merch_code).
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
# Our RSA private key (PEM file). Share only the PUBLIC key with ethio telecom.
TELEBIRR_PRIVATE_KEY_FILE=./keys/merchant_private.pem
# telebirr's public key (PEM file), used to verify signatures on notifications and responses.
TELEBIRR_PUBLIC_KEY_FILE=./keys/telebirr_public.pem
# pss = SHA256withRSAandMGF1 as in the portal's sample code; pkcs1 = classic SHA256withRSA.
TELEBIRR_SIGN_PADDING=pss
# Optional CA certificate (PEM) if the gateway uses a certificate your server does not trust.
# Do NOT turn off certificate checks instead.
TELEBIRR_CA_FILE=
# Minutes the customer has to pay before the order closes (1-120).
TELEBIRR_ORDER_TIMEOUT_MIN=30

# ---- Wi-Fi platform (hotspot login / voucher system) ----
# mock = generate codes locally. http = call WIFI_API_URL (adapt src/adapters/wifi.js to the real API).
WIFI_ADAPTER=mock
WIFI_API_URL=
WIFI_API_KEY=

# ---- SMS gateway ----
# mock = log messages. http = call SMS_API_URL (adapt src/adapters/sms.js to the real API).
SMS_ADAPTER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=wifi.et
